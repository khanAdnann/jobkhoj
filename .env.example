# ---- Copy to .env and adjust for your machine ----

# Spring Boot backend base URL
VITE_API_BASE_URL=http://localhost:8080/api

# Mock mode remains for non-job demo features. Job reads/writes require Supabase.
VITE_API_MODE=mock

# Optional: configure both values to enable Supabase Auth and database access.
# Use the publishable/anon key only; never use a service-role key in Vite.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=