# ---- Copy to .env and adjust for your machine ----

# Spring Boot backend base URL
#VITE_API_BASE_URL=http://localhost:8080/api

# mock = localStorage-backed demo mode; ignores Supabase credentials.
# live = Supabase Auth, jobs, profiles, applications, companies, admin data,
#        saved jobs, job alerts, and resumes. Other legacy endpoints use REST.

# Required when VITE_API_MODE=live.
# Use the publishable/anon key only; never use a service-role key in Vite.
VITE_API_MODE=live
VITE_SUPABASE_URL=https://etxawngnrvfefedyonmu.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_uYbEkf2en1AInn-bqIWMjQ_m1qBS-7g


# =============================================================================
# Ollama AI Configuration (Backend)
# =============================================================================
# Ollama instance URL (defaults to http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Configured LLM model (e.g. qwen2.5-coder:7b, llama3.2, mistral)
OLLAMA_MODEL=qwen2.5-coder:7b

# Generation request timeout in milliseconds (default 120000 = 2 minutes)
OLLAMA_TIMEOUT_MS=120000

# Sampling temperature (0.0 to 1.0, default 0.7)
OLLAMA_TEMPERATURE=0.7

# Optional Bearer token for secured remote Ollama servers
# OLLAMA_AUTH_TOKEN=your-optional-token

# Backend server port (default 8080)
PORT=8080
