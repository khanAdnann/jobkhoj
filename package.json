{
  "name": "jobkhoj",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "JobKhoj - a modern job portal / recruitment platform",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-sitemap.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "smoke": "esbuild scripts/smoke.js --bundle --platform=node --format=esm --jsx=automatic --alias:@=./src --define:import.meta.env.VITE_API_MODE='\"mock\"' --define:import.meta.env.VITE_API_BASE_URL='\"http://localhost:8080/api\"' --external:axios --external:react --external:react/* --external:react-dom --external:react-dom/* --external:react-router-dom --external:lucide-react --external:react-hook-form --external:recharts --outfile=node_modules/.cache/smoke.mjs --log-level=warning && node node_modules/.cache/smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.7.9",
    "jszip": "^3.10.2",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.28.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7"
  }
}
